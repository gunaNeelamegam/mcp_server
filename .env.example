# --- Active plug-ins -------------------------------------------------
CHAT_MODEL_PROVIDER=ollama          # ollama | claude
EMBEDDING_PROVIDER=ollama           # ollama | (future: cloud)
SEARCH_STRATEGY=hybrid              # dense | keyword | hybrid

# --- Ollama ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Claude (only needed if CHAT_MODEL_PROVIDER=claude) ---------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Vector DB -----------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Session store -------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- MCP servers -----------------------------------------------------
SHIPMENTS_MCP_URL=http://localhost:7001

# --- App ---------------------------------------------------------------
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=60
